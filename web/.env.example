# Where the Go crawler's API/metrics server listens (server.addr).
CRAWLER_API_URL=http://localhost:9090

# Must match the crawler's server.api_token / CRAWLER_API_TOKEN, if set.
# Stays server-side: the browser never sees it.
CRAWLER_API_TOKEN=

# If set, /dashboard and its API proxy require HTTP basic auth with
# user "admin" and this password. Set it whenever the dashboard is
# reachable by anyone else.
DASHBOARD_PASSWORD=
